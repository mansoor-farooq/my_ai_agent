{
  "name": "mansoor-agent-hub",
  "version": "1.23.2",
  "private": true,
  "description": "Owner build entrypoint for the Mansoor Farooq private Antigravity agent team.",
  "scripts": {
    "build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\build-agent-hub.ps1",
    "build:package": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\build-agent-hub.ps1 -SkipAutoInstall",
    "agents:install:gemini": "node tools/install-gemini-cli-team.mjs",
    "agents:install:codex": "node tools/install-codex-mobile-specialist.mjs",
    "agents:check:gemini": "node tools/install-gemini-cli-team.mjs --check",
    "skills:update": "node tools/update-skill-references.mjs",
    "skills:refresh:rea": "node tools/refresh-rea-skill.mjs",
    "test": "node --test \"tools/tests/*.test.mjs\"",
    "test:rag": "node tools/rag-ci-gate.mjs",
    "secret-scan": "node tools/secret-scan.mjs .",
    "benchmark": "node tools/agent-benchmark.mjs",
    "dataset": "node tools/agent-training-dataset.mjs export"
  }
}
